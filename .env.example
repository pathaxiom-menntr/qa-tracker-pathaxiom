# QA Tracker Environment Configuration

# Application Port and Host
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development

# Database Connection (PostgreSQL)
# Local development on host machine:
DATABASE_URL=postgres://qa_user:qa_password@localhost:5432/qa_tracker

# Inside Docker Compose network:
# DATABASE_URL=postgres://qa_user:qa_password@db:5432/qa_tracker

# Azure Container Apps / Azure PostgreSQL Flexible Server example:
# DATABASE_URL=postgres://qa_admin%40my-azure-pg:MySecurePassword123!@my-azure-pg.postgres.database.azure.com:5432/qa_tracker?sslmode=require
# DB_SSL=true

# Authentication
JWT_SECRET=dev-secret-change-in-production

# Docker container name fallback (optional, for local development)
DB_CONTAINER=qa-tracker-db
